      function validTurnProjection(b,a) {
        let event=getAfter(/databases/$(database)/documents/games/$(game)/events/$(a.lastCommand)).data;
        return event.type=='game-move' && event.actorUid==request.auth.uid && event.revision==a.revision
          && (event.move.kind!='research-II' || researchIIPlayerTransition(b,a,event))
          && (event.move.kind!='technology-action' || technologyActionPayment(b,a,event))
          && (!(event.move.kind in ['discovery-choice','discovery-advance']) || wideJumpProjection(b,a,event));
      }
      allow update: if signedIn() && ('play' in request.resource.data) && sameTurnRoot(resource.data,request.resource.data)
        && validTurnProjection(resource.data,request.resource.data);
      match /events/{event} {
        function turnEvent() {
          let e=request.resource.data;let m=e.get('move',null);let discoveryMove=m.get('kind','') in ['technology-action','prepare-discovery','prepare-fleet-power','research-II','discovery-choice','discovery-advance','black-market','claim-achievement']; let b=get(gamePath()).data; let a=getAfter(gamePath()).data;
          return e.type == 'game-move' && m is map && m.get('kind','') is string && e.schema == 1 && e.actorUid == request.auth.uid && e.commandId == event && e.revision == a.revision && a.lastCommand == event && e.name == ''
            && discoveryMember(b,e.position)
            && (b.mode == 'tabletop' ? e.keys().hasOnly(['schema','type','actorUid','revision','commandId','position','name','move']) : e.keys().hasOnly(['schema','type','actorUid','revision','commandId','position','name','move','ready','configVersion','settings','code']) && !e.ready && e.configVersion == b.configVersion && e.settings == b.settings && e.code == b.code)
            && (discoveryMove && discoveryTransition(b,a,e) || !discoveryMove && turnTransition(b,a,e));
        }
        allow create: if signedIn() && request.resource.data.type == 'game-move' && turnEvent();
      }
    }
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && code.matches('^[A-Z]{5}$') && request.resource.data.keys().hasOnly(['gameId','ownerUid'])
        && request.resource.data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.mode == 'remote'
        && getAfter(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.code == code
        && getAfter(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.revision == 0;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
